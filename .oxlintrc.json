{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "error",
    "no-console": [
      "warn",
      {
        "allow": ["error", "warn", "info"]
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/features/**",
        "src/app/**",
        "src/api/**",
        "src/domain/**",
        "src/shared/**",
        "src/dev/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/mocks/**", "@/mocks/**", "msw", "msw/*"],
                "message": "UI/API layers must not import mocks (SPEC \u00a76)."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "public/mockServiceWorker.js", "playwright-report", "test-results"]
}
